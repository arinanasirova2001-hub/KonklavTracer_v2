<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state -->
    <item android:state_checked="true">
        <layer-list>
            <item android:drawable="@drawable/hp1" android:width="35dp" android:height="35dp"/>
        </layer-list>
    </item>
    <!-- Unchecked state -->
    <item android:state_checked="false">
        <layer-list>
            <item android:drawable="@drawable/hp2" android:width="35dp" android:height="35dp"/>
        </layer-list>
    </item>
</selector>