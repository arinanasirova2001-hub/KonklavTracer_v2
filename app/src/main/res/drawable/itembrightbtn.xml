<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Цвет фона -->
    <solid android:color="#1A2A2A"/>

    <!-- Скругленные углы -->
    <corners android:radius="8dp"/>

    <!-- Обводка -->
    <stroke
        android:width="1dp"
        android:color="#4DB6AC"/>

    <!-- Отступы для текста -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp"/>
</shape>