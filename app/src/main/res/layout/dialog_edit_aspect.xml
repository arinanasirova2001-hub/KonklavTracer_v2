<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/itembrightbtn"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменение аспекта"
        android:textSize="20sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/tvEditAspectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Аспект"
        android:textSize="18sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnMinusAspect"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="−"
            android:textSize="24sp"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>

        <TextView
            android:id="@+id/tvEditAspectValue"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="32sp"
            android:textColor="@color/bir"
            android:gravity="center"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnPlusAspect"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="+"
            android:textSize="24sp"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Повышение аспекта доступно за достижения в сюжете"
        android:textSize="12sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:textStyle="italic"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancelAspect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Отмена"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>

        <Button
            android:id="@+id/btnSaveAspect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Сохранить"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>
    </LinearLayout>
</LinearLayout>