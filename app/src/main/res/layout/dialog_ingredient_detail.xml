<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/itembrightbtn">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ингредиент"
            android:textSize="22sp"
            android:textColor="@color/bir"
            android:gravity="center"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/tvIngredientDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание"
            android:textSize="15sp"
            android:textColor="@color/bir"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/tvIngredientSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Источник"
            android:textSize="14sp"
            android:textColor="@color/bir"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvIngredientTaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вкус"
            android:textSize="14sp"
            android:textColor="@color/bir"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvIngredientProperties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Свойства"
            android:textSize="14sp"
            android:textColor="@color/bir"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvIngredientSymbolism"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Символизм"
            android:textSize="14sp"
            android:textColor="@color/bir"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvIngredientNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Примечание"
            android:textSize="14sp"
            android:textColor="@color/bir"
            android:textStyle="italic"
            android:paddingBottom="16dp"/>

        <Button
            android:id="@+id/btnCloseIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Закрыть"
            android:textSize="16sp"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>
    </LinearLayout>
</ScrollView>