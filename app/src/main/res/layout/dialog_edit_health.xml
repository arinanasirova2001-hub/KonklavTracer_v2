<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/itembrightbtn"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Изменение здоровья"
        android:textSize="20sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/tvCurrentMaxHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Текущее максимальное здоровье: 10"
        android:textSize="16sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Новое максимальное здоровье:"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingBottom="8dp"/>

    <EditText
        android:id="@+id/etNewMaxHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите число"
        android:textColor="@color/bir"
        android:textColorHint="@color/bir"
        android:background="@drawable/itembrightbtn"
        android:padding="12dp"
        android:inputType="number"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Повышение максимального здоровья доступно за достижения в сюжете"
        android:textSize="12sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:textStyle="italic"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancelHealth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Отмена"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>

        <Button
            android:id="@+id/btnSaveHealth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Сохранить"
            android:textColor="@color/bir"
            android:background="@drawable/itembrightbtn"/>
    </LinearLayout>
</LinearLayout>