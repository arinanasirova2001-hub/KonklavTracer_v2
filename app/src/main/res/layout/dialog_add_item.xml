<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить предмет"
        android:textSize="20sp"
        android:textColor="@color/bir"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="16dp"/>

    <!-- Название -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название:"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingBottom="4dp"/>

    <EditText
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите название"
        android:textColor="@color/bir"
        android:textColorHint="@color/bir"
        android:background="@color/proz"
        android:padding="8dp"
        android:inputType="text"/>

    <!-- Описание -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Описание:"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"/>

    <EditText
        android:id="@+id/etItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Введите описание (необязательно)"
        android:textColor="@color/bir"
        android:textColorHint="@color/bir"
        android:background="@color/proz"
        android:padding="8dp"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:gravity="top"/>

    <!-- Количество -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Количество:"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMinusQuantity"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="-"
            android:textSize="20sp"
            android:textColor="@color/darkbir"
            android:background="@color/bir"/>

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="18sp"
            android:textColor="@color/bir"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnPlusQuantity"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textSize="20sp"
            android:textColor="@color/darkbir"
            android:background="@color/bir"/>
    </LinearLayout>

    <!-- Экипировка -->
    <CheckBox
        android:id="@+id/cbEquipped"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Экипировано"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingTop="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Категория:"
        android:textSize="14sp"
        android:textColor="@color/bir"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerItemCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/itembrightbtn"/>


    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/btnCancelAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Отмена"
            android:textColor="@color/bir"
            android:background="@color/proz"/>

        <Button
            android:id="@+id/btnConfirmAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Добавить"
            android:textColor="@color/darkbir"
            android:background="@color/bir"/>
    </LinearLayout>
</LinearLayout>