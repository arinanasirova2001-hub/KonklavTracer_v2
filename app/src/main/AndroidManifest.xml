<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        tools:targetApi="31">

        <!-- Главный экран со списком персонажей -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Экран создания персонажа -->
        <activity
            android:name=".ui.CreateCharacterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.IngredientsListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RunesListActivity"
            android:exported="false" />

        <!-- Экран персонажа (с вкладками) -->
        <activity
            android:name=".ui.CharacterSheetActivity"
            android:exported="false" />

        <!-- База знаний -->
        <activity
            android:name=".ui.KnowledgeBaseActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SchoolDetailActivity"
            android:exported="false" />

        <!-- Заметки -->
        <activity
            android:name=".ui.NotesActivity"
            android:exported="false" />

        <!-- Редактирование персонажа -->
        <activity
            android:name=".ui.EditCharacterActivity"
            android:exported="false" />

    </application>

</manifest>